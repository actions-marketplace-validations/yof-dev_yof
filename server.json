{
  "$schema": "https://static.modelcontextprotocol.io/schemas/2025-12-11/server.schema.json",
  "name": "io.yof/yof",
  "title": "yof",
  "description": "Checks AI-written code for leaked keys and made-up packages, on your machine. Never uploads code.",
  "version": "0.3.1",
  "repository": { "url": "https://github.com/yof-dev/yof", "source": "github" },
  "websiteUrl": "https://yof.io/docs/ai-builders",
  "icons": [
    { "src": "https://yof.io/news/press-kit/yof-logo-light.png", "mimeType": "image/png", "sizes": ["1152x356"], "theme": "light" },
    { "src": "https://yof.io/news/press-kit/yof-logo-dark.png", "mimeType": "image/png", "sizes": ["1152x356"], "theme": "dark" },
    { "src": "https://yof.io/news/press-kit/yof-logo-light.svg", "mimeType": "image/svg+xml", "sizes": ["any"], "theme": "light" },
    { "src": "https://yof.io/news/press-kit/yof-logo-dark.svg", "mimeType": "image/svg+xml", "sizes": ["any"], "theme": "dark" }
  ],
  "packages": [
    {
      "registryType": "npm",
      "identifier": "@yof/cli",
      "version": "0.3.1",
      "runtimeHint": "npx",
      "transport": { "type": "stdio" },
      "packageArguments": [{ "type": "positional", "value": "mcp" }],
      "environmentVariables": [
        { "name": "YOF_API_KEY", "description": "Optional. The key the yof dashboard makes for this connection (Connect your AI builder). Without it, only the local tools run.", "isRequired": false, "isSecret": true }
      ]
    }
  ],
  "remotes": [
    {
      "type": "streamable-http",
      "url": "https://mcp.yof.io/mcp",
      "headers": [
        { "name": "Authorization", "description": "Bearer followed by the key the yof dashboard makes for this connection. Needed to run any tool; the tool list can be read without it.", "isRequired": true, "isSecret": true }
      ]
    }
  ]
}
